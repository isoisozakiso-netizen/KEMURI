# ぷかり (Pukari) — environment variables example
# Copy to `.dev.vars` for local Wrangler dev, or set as Cloudflare Worker
# secrets in production (`wrangler secret put NAME` or the dashboard).
# Do NOT commit real values.

# --- Cloudflare (only needed for CLI deploy / CI) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Application ---
# Hotpepper Gourmet API key: https://webservice.recruit.co.jp/
HOTPEPPER_KEY=
# Secret used to sign share-link tokens (any long random string)
SHARE_SECRET=
# Contact address for security/abuse reports
ADMIN_EMAIL=

# --- Affiliate (reserved for future use; not yet wired up) ---
# A8_AFFILIATE_ID=
# MOSHIMO_AFFILIATE_ID=
